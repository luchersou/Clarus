generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["documents"]
}

model Document {
  id            String         @id @default(uuid())
  userId        String
  fileName      String
  fileType      FileType
  fileSizeBytes Int
  storageUrl    String
  status        DocumentStatus @default(UPLOADED)
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@schema("documents")
}

enum FileType {
  PDF
  DOCX
  XLSX

  @@schema("documents")
}

enum DocumentStatus {
  UPLOADED
  PROCESSED
  FAILED

  @@schema("documents")
}
