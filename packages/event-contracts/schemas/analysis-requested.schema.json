{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisRequestedEvent",
  "type": "object",
  "required": ["analysisId", "documentId", "userId", "type"],
  "properties": {
    "analysisId": { "type": "string", "format": "uuid" },
    "documentId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "type": {
      "type": "string",
      "enum": ["SUMMARY", "EXTRACT_VALUES", "DEADLINES", "COMPARE"]
    }
  }
}